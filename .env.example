# 本番でも元のExcelの2026年11月のデータを入れて始めたいときだけ true にする（既定は空の状態）
# NEXT_PUBLIC_USE_SEED=true
# ブラウザへの保存に使うキー名（既定: nikkei-hyo-next-v1）
# NEXT_PUBLIC_STORE_KEY=nikkei-hyo-next-v1

# 共有データベース（Vercel の Upstash Redis を接続すると自動で入る）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# 全員で共有するアクセスコード（本番では必須）
# ACCESS_CODE=
# 他のユーザーの更新を確認する間隔(ミリ秒)。既定 60000
# NEXT_PUBLIC_SYNC_INTERVAL=60000
